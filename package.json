{
  "name": "escala",
  "version": "0.1.0",
  "private": true,
  "description": "Escala seller support triage workspace",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "validate:demo": "node scripts/validate-demo-data.mjs",
    "test": "node --test",
    "test:integration": "node --test tests/inbox-integration.test.mjs",
    "refresh:analysis": "node --env-file=.env.local --import tsx scripts/refresh-analysis.mts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "mongodb": "^7.6.0",
    "next": "^16.3.6",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
