# Escala MVP defaults. Do not put real secrets in this file.
ESCALA_DATA_MODE=mongodb
ESCALA_OPENAI_MODE=live
ESCALA_ENABLE_EXTERNAL_SEND=false
ESCALA_CONFIDENCE_THRESHOLD=0.90
# Applied only when creating workspace settings. Existing workspaces use /api/autonomy.
ESCALA_AUTONOMY_MODE=DRAFT_ONLY
# Set 0 if a dedicated scripts/process-inbox.mts worker handles the same Mongo jobs.
ESCALA_AUTONOMY_WORKER=1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=xhigh
OPENAI_API_KEY=
MONGODB_URI=
MONGODB_DB=escala
# Local English model exported by scripts/sentiment.py. No remote model downloads.
ESCALA_SENTIMENT_MODEL_PATH=data/models/english
# Only for the Claude Code backend worker. Never use this for Escala runtime LLM calls.
DEEPSEEK_API_KEY=
# Vercel deployment credential; leave blank until set on the Vercel account.
VERCEL_TOKEN=
